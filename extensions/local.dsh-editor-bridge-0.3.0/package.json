{
  "name": "dsh-editor-bridge",
  "displayName": "DSH Editor Bridge",
  "description": "在 VS Code 侧栏里直接和 DSH 对话（复用 DSH 配置的模型），并把选区发给 DSH Agents",
  "version": "0.3.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:dshEditor.chat",
    "onCommand:dshEditorBridge.sendSelection",
    "onCommand:dshEditorBridge.sendFile",
    "onCommand:dshEditorBridge.askSelection",
    "onCommand:dshEditorBridge.newChat",
    "onCommand:dshEditorBridge.focusChat",
    "onCommand:dshEditorBridge.sendExplorerFiles",
    "onCommand:dshEditorBridge.sendExplorerFolder",
    "onCommand:dshEditorBridge.sendTerminalSelection",
    "onCommand:dshEditorBridge.importRules",
    "onCommand:dshEditorBridge.nextEdit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshEditor",
          "title": "DSH",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dshEditorSecondary",
          "title": "DSH",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dshEditor": [
        {
          "id": "dshEditor.chat",
          "name": "Chat",
          "type": "webview"
        }
      ],
      "dshEditorSecondary": [
        {
          "id": "dshEditor.chat",
          "name": "Chat",
          "type": "webview",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "dshEditorBridge.sendSelection",
        "title": "发送给 DSH Agents（当前选区）",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.sendFile",
        "title": "发送给 DSH Agents（当前文件）",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.askSelection",
        "title": "在 DSH Chat 中询问选中代码",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.newChat",
        "title": "新对话",
        "category": "DSH",
        "icon": "$(add)"
      },
      {
        "command": "dshEditorBridge.focusChat",
        "title": "打开 DSH Chat",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.sendExplorerFiles",
        "title": "发送给 DSH Agents（选中文件）",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.sendExplorerFolder",
        "title": "发送给 DSH Agents（选中目录）",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.sendTerminalSelection",
        "title": "发送给 DSH Agents（终端选区）",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.importRules",
        "title": "把旧规则文件导入 AGENTS.md",
        "category": "DSH"
      },
      {
        "command": "dshEditorBridge.nextEdit",
        "title": "预测下一处编辑",
        "category": "DSH"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dshEditorBridge.askSelection",
          "group": "navigation@98",
          "when": "editorHasSelection"
        },
        {
          "command": "dshEditorBridge.sendSelection",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "dshEditorBridge.newChat",
          "when": "view == dshEditor.chat",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dshEditorBridge.focusChat",
          "when": "true"
        },
        {
          "command": "dshEditorBridge.importRules",
          "group": "dsh@1"
        }
      ],
      "explorer/context": [
        {
          "command": "dshEditorBridge.sendExplorerFiles",
          "group": "dsh@1",
          "when": "explorerResourceIsFolder == false"
        },
        {
          "command": "dshEditorBridge.sendExplorerFolder",
          "group": "dsh@1",
          "when": "explorerResourceIsFolder == true"
        }
      ],
      "terminal/context": [
        {
          "command": "dshEditorBridge.sendTerminalSelection",
          "group": "dsh@1"
        }
      ]
    },
    "configuration": {
      "properties": {
        "dshEditorBridge.inlineCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用行内代码补全（Tab 接受、Esc 取消）。默认关闭：补全会持续调用模型，按需开启。"
        },
        "dshEditorBridge.nextEdit.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用「下一处编辑预测」。默认关闭：每次触发都会调用模型。快捷键 Shift+Alt+N。"
        }
      }
    },
    "keybindings": [
      {
        "command": "dshEditorBridge.nextEdit",
        "key": "shift+alt+n",
        "when": "editorTextFocus"
      }
    ]
  }
}
